# ---------------------------------------------------------------------------
# AskPDF environment
#
# Copy to .env for local development:  cp .env.example .env
# Every key is validated at boot by src/config/env.js — the process exits
# with a description of what is wrong rather than starting half-configured.
# Values without a default are REQUIRED.
# ---------------------------------------------------------------------------

# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SERVICE_NAME=askpdf

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=debug
# Human-readable log output. Leave false in production so records stay JSON.
LOG_PRETTY=true

# ---- HTTP -----------------------------------------------------------------
# Comma-separated allow-list. "*" is rejected when NODE_ENV=production.
CORS_ORIGINS=*
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=15000
SHUTDOWN_DRAIN_MS=5000
TRUST_PROXY=true

# ---- MongoDB (REQUIRED) ---------------------------------------------------
MONGO_URI=mongodb://localhost:27017/askpdf
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# ---- Redis (REQUIRED) -----------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=askpdf

# ---- Queue ----------------------------------------------------------------
QUEUE_NAME=ingest
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_BASE_MS=2000
QUEUE_BLOCK_TIMEOUT_SEC=5
QUEUE_VISIBILITY_TIMEOUT_MS=300000
WORKER_CONCURRENCY=2
JOB_STATUS_TTL_SEC=86400

# ---- Storage --------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Required only when STORAGE_DRIVER=s3
# S3_BUCKET=askpdf-documents
# S3_REGION=ap-south-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ---- Uploads --------------------------------------------------------------
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=500

# ---- Chunking -------------------------------------------------------------
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ---- AI provider (GEMINI_API_KEY is REQUIRED) -----------------------------
# Use AI_PROVIDER=fake for offline development; rejected in production.
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-me
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.0-flash
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=3

# ---- Retrieval ------------------------------------------------------------
# Chunks below this cosine similarity never reach the model.
RETRIEVAL_MIN_SCORE=0.7
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=100
VECTOR_INDEX_NAME=chunk_embedding_index
# "atlas" requires a MongoDB Atlas vector search index.
VECTOR_SEARCH_DRIVER=memory

# ---- Auth (REQUIRED, minimum 32 characters each) --------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=askpdf
JWT_AUDIENCE=askpdf-api
BCRYPT_ROUNDS=12

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_CHAT_MAX=30

# ---- Observability --------------------------------------------------------
METRICS_ENABLED=true
METRICS_PATH=/metrics
SWAGGER_ENABLED=true
